#!/bin/sh
# Blocks key material from entering a public repo, including `git add -f`,
# which .gitignore cannot stop. Bypass only if you are certain: --no-verify.

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# 1. Filenames that are key material by extension.
for f in $staged; do
  case "$f" in
    *.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|.env|.env.*)
      echo "  ✗ $f looks like key material or secrets"
      fail=1
      ;;
  esac
done

# 2. Any staged file whose contents carry a private key, whatever it is called.
for f in $staged; do
  if git show ":$f" 2>/dev/null | grep -qE 'BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY'; then
    echo "  ✗ $f contains a PRIVATE KEY block"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "  Commit blocked: this repo is public."
  echo "  Unstage the file(s) above, or use --no-verify if you are certain."
  echo
  exit 1
fi
exit 0
